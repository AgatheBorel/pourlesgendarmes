---
import Logo from './Logo.astro';
import { demenagement, menu } from '../data/navigation';
const path = Astro.url.pathname;
const actif = (href: string) => path === href || (href === '/articles/' && path.startsWith('/articles/') && !path.startsWith('/articles/rubrique/demenagement'));
const demActif = demenagement.sous.some((s) => path === s.href) || path === demenagement.href;
---
<header class="entete">
  <div class="conteneur entete-in">
    <a href="/" class="logo" aria-label="Pour les gendarmes, accueil"><Logo /></a>

    <nav aria-label="Navigation principale" class="nav-bureau">
      <ul class="nav-liste">
        <li class="deroulant" id="deroulant-dem">
          <a href={demenagement.href} class="lien-dem" aria-current={demActif ? 'page' : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" fill="currentColor"/><circle cx="17.5" cy="17.5" r="1.8" fill="currentColor"/></svg>
            {demenagement.label}
          </a>
          <button class="ouvrir" type="button" aria-expanded="false" aria-controls="sous-dem" aria-label="Afficher le sous-menu Déménagement">
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <ul class="sous-menu" id="sous-dem">
            {demenagement.sous.map((s) => (
              <li><a href={s.href} aria-current={path === s.href ? 'page' : undefined}><span class="sm-titre">{s.label}</span><span class="sm-texte">{s.texte}</span></a></li>
            ))}
          </ul>
        </li>
        {menu.map((l) => <li><a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="entete-actions">
      <a class="bouton bouton-principal bouton-entete" href="/demande-de-devis/">Devis déménagement</a>
      <details class="menu-mobile">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Navigation mobile">
          <p class="mm-titre">Déménagement</p>
          <ul class="mm-dem">
            {demenagement.sous.map((s) => <li><a href={s.href} aria-current={path === s.href ? 'page' : undefined}>{s.label}</a></li>)}
          </ul>
          <p class="mm-titre">Guides et conseils</p>
          <ul>
            {menu.map((l) => <li><a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
            <li><a href="/faq/">Questions fréquentes</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const d = document.getElementById('deroulant-dem');
  const b = d?.querySelector<HTMLButtonElement>('.ouvrir');
  b?.addEventListener('click', () => {
    const ouvert = d!.classList.toggle('ouvert');
    b.setAttribute('aria-expanded', String(ouvert));
  });
  document.addEventListener('click', (e) => {
    if (d && !d.contains(e.target as Node)) { d.classList.remove('ouvert'); b?.setAttribute('aria-expanded', 'false'); }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && d?.classList.contains('ouvert')) { d.classList.remove('ouvert'); b?.setAttribute('aria-expanded', 'false'); b?.focus(); }
  });
</script>

<style>
  .entete { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--fond-verre); backdrop-filter: blur(8px); border-bottom: 1px solid var(--ligne); }
  .entete-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 70px; }
  .logo { text-decoration: none; flex: none; }
  .nav-liste { list-style: none; display: flex; align-items: center; gap: 1.3rem; margin: 0; padding: 0; }
  .nav-liste > li > a { color: var(--encre); text-decoration: none; font-weight: 500; }
  .nav-liste > li > a:hover, .nav-liste > li > a[aria-current=page] { color: var(--primaire); text-decoration: underline; text-underline-offset: .35em; }

  /* Déménagement : entrée mise en avant */
  .deroulant { position: relative; display: flex; align-items: center; background: var(--doux); border-radius: 999px; padding: .1rem .2rem .1rem .8rem; }
  .nav-liste .lien-dem { display: inline-flex; align-items: center; gap: .4rem; font-weight: 700; color: var(--primaire-fonce); text-decoration: none; padding: .35rem 0; }
  .nav-liste .lien-dem:hover { text-decoration: underline; text-underline-offset: .35em; }
  .ouvrir { display: grid; place-items: center; width: 30px; height: 30px; border: 0; border-radius: 50%; background: transparent; color: var(--primaire-fonce); cursor: pointer; }
  .ouvrir:hover { background: var(--surface); }
  .deroulant.ouvert .ouvrir svg, .deroulant:hover .ouvrir svg { rotate: 180deg; }
  .sous-menu { display: none; position: absolute; left: 0; top: 100%; padding: 10px 0 0; list-style: none; margin: 0; width: 330px; }
  .sous-menu::before { content: ""; position: absolute; inset: 10px 0 0; background: var(--surface); border: 1px solid var(--ligne); border-radius: 12px; box-shadow: 0 18px 40px -22px var(--ombre); z-index: -1; }
  .deroulant:hover .sous-menu, .deroulant:focus-within .sous-menu, .deroulant.ouvert .sous-menu { display: block; }
  .sous-menu li:first-child { margin-top: .4rem; } .sous-menu li:last-child { margin-bottom: .4rem; }
  .sous-menu a { display: grid; gap: .1rem; margin: 0 .4rem; padding: .6rem .8rem; border-radius: 8px; text-decoration: none; }
  .sous-menu a:hover, .sous-menu a[aria-current=page] { background: var(--doux); }
  .sm-titre { font-weight: 600; color: var(--encre); }
  .sm-texte { font-size: .88rem; color: var(--encre-douce); }
  .sous-menu li:last-child .sm-titre { color: var(--primaire); }

  .entete-actions { display: flex; align-items: center; gap: .6rem; }
  .bouton-entete { padding: .5rem .95rem; min-height: 42px; font-size: .96rem; white-space: nowrap; }
  .menu-mobile { display: none; position: relative; }
  .menu-mobile summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; border-radius: var(--r); border: 1.5px solid var(--ligne); background: var(--surface); }
  .menu-mobile summary::-webkit-details-marker { display: none; }
  .menu-mobile summary span { display: block; width: 18px; height: 2px; background: var(--encre); border-radius: 2px; }
  .menu-mobile nav { position: absolute; right: 0; top: calc(100% + 8px); width: min(86vw, 300px); background: var(--surface); border: 1px solid var(--ligne); border-radius: 12px; box-shadow: 0 16px 40px -20px var(--ombre); padding: .6rem; }
  .mm-titre { margin: .4rem .9rem .2rem; font-size: .8rem; font-weight: 700; color: var(--encre-douce); }
  .menu-mobile ul { list-style: none; margin: 0 0 .3rem; padding: 0; }
  .mm-dem { background: var(--doux); border-radius: 10px; padding: .25rem !important; }
  .menu-mobile a { display: block; padding: .7rem .9rem; border-radius: var(--r); color: var(--encre); text-decoration: none; font-weight: 500; }
  .mm-dem a { color: var(--primaire-fonce); font-weight: 600; }
  .menu-mobile a:hover, .menu-mobile a[aria-current=page] { background: var(--surface); color: var(--primaire); }
  .menu-mobile ul:not(.mm-dem) a:hover, .menu-mobile ul:not(.mm-dem) a[aria-current=page] { background: var(--doux); }
  @media (max-width: 1060px) { .nav-bureau { display: none; } .menu-mobile { display: block; } }
  @media (max-width: 760px) { .bouton-entete { display: none; } }
</style>
