---
// Première étape du devis, directement dans la page : 3 champs, puis suite sur /demande-de-devis/ pré-remplie.
interface Props { id?: string; titre?: string; }
const { id = 'rapide', titre = 'Recevez vos devis de déménagement' } = Astro.props;
---
<form class="rapide" action="/demande-de-devis/" method="get" aria-labelledby={`${id}-titre`}>
  <h2 id={`${id}-titre`} class="rapide-titre">{titre}</h2>
  <p class="rapide-sous">Gratuit et sans engagement. Environ deux minutes.</p>
  <div class="rapide-champs">
    <div class="champ">
      <label for={`${id}-depart`}>Code postal de départ</label>
      <input id={`${id}-depart`} name="depart_cp" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="off" placeholder="ex. 35000" />
    </div>
    <div class="champ">
      <label for={`${id}-arrivee`}>Code postal d'arrivée</label>
      <input id={`${id}-arrivee`} name="arrivee_cp" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="off" placeholder="si connu" />
    </div>
    <div class="champ">
      <label for={`${id}-mois`}>Mois du déménagement</label>
      <input id={`${id}-mois`} name="date_souhaitee" type="month" />
    </div>
  </div>
  <button class="bouton bouton-principal rapide-bouton" type="submit">Continuer ma demande</button>
  <ul class="rapide-garanties">
    <li>Un conseiller vous rappelle au créneau de votre choix</li>
    <li>Vos données ne sont ni vendues ni cédées</li>
  </ul>
</form>
<style>
  .rapide { background: var(--surface); border: 1px solid var(--ligne); border-top: 4px solid var(--primaire); border-radius: 14px; padding: clamp(1.3rem, 3vw, 1.9rem); box-shadow: 0 18px 40px -28px var(--ombre); }
  .rapide-titre { font-size: 1.4rem; margin-bottom: .2rem; }
  .rapide-sous { color: var(--encre-douce); margin-bottom: 1.1rem; }
  .rapide-champs { display: grid; grid-template-columns: 1fr 1fr; gap: 0 .9rem; }
  .rapide-champs .champ:last-child { grid-column: 1 / -1; }
  .rapide-bouton { width: 100%; font-size: 1.08rem; }
  .rapide-garanties { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .35rem; font-size: .93rem; color: var(--encre-douce); }
  .rapide-garanties li { padding-left: 1.5rem; position: relative; }
  .rapide-garanties li::before { content: ""; position: absolute; left: .15rem; top: .38em; width: .8rem; height: .45rem; border-left: 2px solid var(--primaire); border-bottom: 2px solid var(--primaire); rotate: -45deg; }
  @media (max-width: 420px) { .rapide-champs { grid-template-columns: 1fr; } }
</style>
