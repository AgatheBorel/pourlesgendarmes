---
// Mesure d'audience Matomo, hébergée sur stats.pourlesgendarmes.fr.
// Configuration exemptée de consentement (recommandations CNIL) : aucun cookie, adresse IP anonymisée
// côté Matomo, statistiques anonymes uniquement. Un visiteur peut s'y opposer depuis la page
// Données personnelles : son choix est mémorisé dans son navigateur et le suivi n'est alors plus chargé.
---
<script is:inline>
  (function () {
    var refus = false;
    try { refus = localStorage.getItem('plg-mesure-refusee') === '1'; } catch (e) {}
    if (refus || navigator.doNotTrack === '1') return;
    var _paq = (window._paq = window._paq || []);
    _paq.push(['disableCookies']);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    var u = 'https://stats.pourlesgendarmes.fr/';
    _paq.push(['setTrackerUrl', u + 'matomo.php']);
    _paq.push(['setSiteId', '1']);
    var g = document.createElement('script');
    g.async = true;
    g.src = u + 'matomo.js';
    document.head.appendChild(g);
  })();
</script>
