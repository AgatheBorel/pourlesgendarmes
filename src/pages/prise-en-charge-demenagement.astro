  .tableau { overflow-x: auto; margin: 1.5rem 0; font-family: var(--f-ui); font-size: 1rem; }
  table { border-collapse: collapse; width: 100%; min-width: 520px; background: var(--surface); border-radius: var(--r); overflow: hidden; }
  th, td { text-align: left; padding: .8rem 1rem; border-bottom: 1px solid var(--ligne); vertical-align: top; line-height: 1.4; }
  thead th { background: var(--primaire); color: #fff; font-weight: 600; }
  tbody th { font-weight: 600; width: 30%; }
</style>
